---
import { site } from '../lib/config';
interface Props { current?: string; asOf?: string }
const { current, asOf } = Astro.props;
---
<nav class="nav">
  <a href="/" style="font-weight: 500">{site.title}</a>
  <span class="links">
    {site.nav.map((l) => <a href={l.href} aria-current={current === l.label ? 'page' : undefined}>{l.label}</a>)}
  </span>
  <span class="muted">as of {asOf ?? new Date().toISOString().slice(0, 10)}</span>
</nav>
