---
import { site } from '../lib/config';
---
<footer class="foot">
  <span>rendered from github.com/{site.owner}: a w3.yaml in each repository for its family, tags for releases, pushed-at for last touched. nothing on this site was written for it.</span>
  <span style="display: flex; flex-wrap: wrap; gap: 24px">
    {site.links.map((l) => <a href={l.href}>{l.label}</a>)}
  </span>
</footer>
